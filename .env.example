# Google Cloud Console > APIs & Services > Credentials > OAuth 2.0 Client ID (Web application)
GOOGLE_CLIENT_ID=your-web-client-id.apps.googleusercontent.com

# When enabled, every API route except health/auth requires an AriX session.
ARIX_AUTH_REQUIRED=1

# Private company registration code. New Google users remain inactive until owner approval.
ARIX_COMPANY_JOIN_CODE=replace-with-a-long-random-secret

# Optional first-owner allowlist. Use only to attach the initial Google account.
ARIX_GOOGLE_BOOTSTRAP_EMAILS=owner@example.com

# Session lifetime in hours (default: 168 = 7 days).
ARIX_SESSION_TTL_HOURS=720

# Optional comma-separated cross-origin clients. Same-origin Vite proxy does not need this.
ARIX_ALLOWED_ORIGINS=https://ersarif.tail13f45d.ts.net

# SMTP for sending document PDFs. Use an app password or provider-specific SMTP credential.
ARIX_SMTP_HOST=smtp.example.com
ARIX_SMTP_PORT=587
ARIX_SMTP_SECURE=0
ARIX_SMTP_USER=documents@example.com
ARIX_SMTP_PASS=replace-with-an-app-password
ARIX_SMTP_FROM=AriX Panel <documents@example.com>
# Sipariş onay PDF'lerinin kaydedileceği Windows/ağ klasörü.
ARIX_ORDER_ARCHIVE_ROOT=\\ERSARIF\SharedFolder\ErsaShare\YURT İÇİ
ARIX_EXPORT_ARCHIVE_ROOT=\\ERSARIF\SharedFolder\ErsaShare\IHRACAT
ARIX_PDF_BROWSER_PATH=C:\Program Files (x86)\Microsoft\Edge\Application\msedge.exe
ARIX_ARCHIVE_SYNC_TOKEN=replace-with-a-long-random-secret
ARIX_VAPID_PUBLIC_KEY=
ARIX_VAPID_PRIVATE_KEY=

# Onay formu gecikme eşikleri (saat). Uyarı ve kritik seviyede bir kez bildirim gider.
ARIX_APPROVAL_SLA_WARN_HOURS=4
ARIX_APPROVAL_SLA_CRITICAL_HOURS=24

# Sohbet geçmişi arşivi: kanal başına ve toplam mesaj sınırı; aşan kısım data/chat-archive altına yazılır.
ARIX_CHAT_ARCHIVE_PER_CHANNEL=3000
ARIX_CHAT_ARCHIVE_TOTAL=8000
