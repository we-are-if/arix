# Google Cloud Console > APIs & Services > Credentials > OAuth 2.0 Client ID (Web application)
GOOGLE_CLIENT_ID=your-web-client-id.apps.googleusercontent.com

# When enabled, every API route except health/auth requires an AriX session.
ARIX_AUTH_REQUIRED=1

# Optional first-owner allowlist. Use only to attach the initial Google account.
ARIX_GOOGLE_BOOTSTRAP_EMAILS=owner@example.com

# Session lifetime in hours (default: 168 = 7 days).
ARIX_SESSION_TTL_HOURS=168

# Optional comma-separated cross-origin clients. Same-origin Vite proxy does not need this.
ARIX_ALLOWED_ORIGINS=https://ersarif.tail13f45d.ts.net
