[Unit]
Description=AriX Cloudflare Tunnel
After=network-online.target nginx.service arix-api.service
Wants=network-online.target

[Service]
Type=simple
ExecStart=/usr/bin/cloudflared tunnel run --token-file /etc/arix/cloudflared-token
Restart=always
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadOnlyPaths=/etc/arix/cloudflared-token

[Install]
WantedBy=multi-user.target
