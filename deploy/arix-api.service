[Unit]
Description=AriX Panel API
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=arix
Group=arix
WorkingDirectory=/opt/arix
EnvironmentFile=/etc/arix/arix.env
ExecStart=/usr/bin/node server/index.js
Restart=always
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ReadWritePaths=/opt/arix/server/data /srv/arix

[Install]
WantedBy=multi-user.target
